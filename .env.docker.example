# PostgreSQL Configuration (Docker db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=gist_db

# Database Connection URL (Docker internal network pointing to db service)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-for-docker
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO

